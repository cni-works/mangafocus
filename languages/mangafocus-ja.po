msgstr "コピーしました"

msgid "Copy"
msgstr "コピー"

msgid "Copy shortcode"
msgstr "ショートコードをコピー"

msgid "Copy shortcode %s"
msgstr "ショートコード %s をコピー"

msgid "Copy the current pages and Viewer settings as an independent comic. Saved extension settings are retained and the original Viewer is not changed."
msgstr "現在のページとViewer設定を独立した漫画としてコピーします。保存済みの追加設定も保持され、元のViewerは変更されません。"

msgid "Core version"
msgstr "Coreバージョン"

msgid "Could not copy."
msgstr "コピーできませんでした。"

msgid "Could not load Manga Library."
msgstr "漫画ライブラリを読み込めませんでした。"

msgid "Could not register the comic in Manga Library."
msgstr "漫画ライブラリへの登録に失敗しました。"

msgid "Cover"
msgstr "表紙"

