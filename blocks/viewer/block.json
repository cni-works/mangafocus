{
  "apiVersion": 3,
  "name": "ai-manga-viewer/viewer",
  "title": "MangaFocus",
  "category": "ai-manga-viewer",
  "icon": "book-alt",
  "description": "Display manga images with paged, spread, fullscreen, and Panel-by-Panel reading.",
  "keywords": [ "Manga", "Comic", "Viewer", "Page turn", "Booklet" ],
  "textdomain": "mangafocus",
  "attributes": {
    "pages": { "type": "array", "default": [] },
    "viewerKey": { "type": "string", "default": "" },
    "instanceKey": { "type": "string", "default": "" },
    "libraryViewerId": { "type": "integer", "default": 0 },
    "binding": { "type": "string", "default": "rtl" },
    "pageLayout": { "type": "string", "default": "single" },
    "singleFirstPage": { "type": "boolean", "default": true },
    "spreadReadingMode": { "type": "string", "default": "overview" },
    "maxWidth": { "type": "number", "default": 650 },
    "showPageNumbers": { "type": "boolean", "default": true },
    "enableEdgeClick": { "type": "boolean", "default": true },
    "showGuideArrowOnAllPages": { "type": "boolean", "default": false },
    "enableAnimation": { "type": "boolean", "default": true },
    "enableFullscreen": { "type": "boolean", "default": false },
    "fullscreenStartAtCurrent": { "type": "boolean", "default": false },
    "inlineDisplayMode": { "type": "string", "default": "reader" },
    "fullscreenReadingMode": { "type": "string", "default": "paged" },
    "enableZoom": { "type": "boolean", "default": false },
    "zoomControlsPosition": { "type": "string", "default": "bottom" },
    "scrollAssist": { "type": "boolean", "default": false },
    "scrollAssistPosition": { "type": "string", "default": "auto" },
    "scrollAssistStrength": { "type": "string", "default": "normal" },
    "focusReader": { "type": "boolean", "default": false },
    "focusReaderStartAtCurrent": { "type": "boolean", "default": false },
    "mobileFocusReader": { "type": "boolean", "default": false }
  },
  "supports": {
    "align": [ "wide", "full" ],
    "anchor": true,
    "html": false
  }
}
